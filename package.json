{
  "name": "neural-arcade",
  "version": "1.1.0",
  "private": true,
  "description": "Juego educativo interactivo para aprender inteligencia artificial desde cero en 26 niveles.",
  "license": "MIT",
  "author": "Ozkar K. Azares",
  "repository": {
    "type": "git",
    "url": "https://github.com/ocazare2/Neural-Arcade.git"
  },
  "homepage": "https://github.com/ocazare2/Neural-Arcade#readme",
  "bugs": {
    "url": "https://github.com/ocazare2/Neural-Arcade/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run build",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.525.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@babel/core": "^7.29.1",
    "@humanfs/node": "^0.17.0",
    "baseline-browser-mapping": "^2.11.25",
    "browserslist": "^4.29.0",
    "minimatch": "^3.1.3",
    "brace-expansion": "^1.1.17",
    "flatted": "^3.4.0",
    "js-yaml": "^4.3.2",
    "picomatch": "^2.3.2"
  },
  "knip": {
    "ignore": [
      "public/sw.js"
    ]
  }
}
